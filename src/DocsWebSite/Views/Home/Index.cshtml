@{
	Layout = null;
}

<!DOCTYPE html>
<html>
<head>
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<meta name="viewport" content="width=device-width,initial-scale=1">
	<meta charset="UTF-8">
	<link rel="stylesheet" href="~/libs/docsify/themes/vue.css" />
	<link rel="stylesheet" href="~/libs/docsify-toc/toc.css" />
	<link rel="stylesheet" href="~/libs/printjs/print.css" />
	<link rel="stylesheet" href="~/libs/docsify-print/style.css" />
</head>
<body>
	<div id="app"></div>
	<script>
			  window.$docsify = {
				  loadSidebar: true,
				  name: 'Docs Site',
				  alias: {
					  '/.*/_sidebar.md': '/_sidebar.md'
				  },
				  subMaxLevel: 3,
				  //coverpage: true,
				  themeColor: 'orangered',
				  autoHeader: true,
				   toc: {
		  scope: '.markdown-section',
		  headings: 'h1, h2, h3, h4, h5, h6',
		  title: 'Table of Contents',
		}
			  }
	</script>
	<script src="~/libs/docsify/docsify.min.js"></script>
	<script src="~/libs/docsify/plugins/search.min.js"></script>
	<script src="~/libs/docsify-pagenation/docsify-pagination.min.js"></script>
	<script src="~/libs/prismjs/components/prism-csharp.min.js"></script>
	<script src="~/libs/prismjs/components/prism-powershell.min.js"></script>
	<script src="~/libs/prismjs/components/prism-plsql.min.js"></script>
	<script src="~/libs/prismjs/components/prism-sql.min.js"></script>
	<script src="~/libs/prismjs/components/prism-batch.min.js"></script>
	<script src="~/libs/prismjs/components/prism-aspnet.min.js"></script>
	<script src="~/libs/prismjs/components/prism-cpp.min.js"></script>
	<script src="~/libs/prismjs/components/prism-css.min.js"></script>
	<script src="~/libs/prismjs/components/prism-json.min.js"></script>
	<script src="~/libs/prismjs/components/prism-typescript.min.js"></script>
	<script src="~/libs/docsify-toc/toc.js"></script>
	<script src="~/libs/docsify-copy-code/docsify-copy-code.min.js"></script>
	<script src="~/libs/docsify/plugins/zoom-image.min.js"></script>
	<script src="~/libs/printjs/print.js"></script>
	<script src="~/libs/docsify-print/index.js"></script>
</body>
</html>